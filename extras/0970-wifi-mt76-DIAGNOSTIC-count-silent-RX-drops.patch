From: Joel Groves <happygreentreefrog@gmail.com>
Subject: [PATCH] wifi: mt76: DIAGNOSTIC: count silent RX drops

Temporary diagnostic, not for upstream. Counts every place the RX path
frees a frame or hides it from mac80211 (RX_FLAG_ONLY_MONITOR) without
any other counter, and logs the last PN check failures with the frame PN
and the stored per-TID PN. Read from debugfs:
/sys/kernel/debug/ieee80211/phy0/mt76/rx_drop_diag

---
diff --git a/agg-rx.c b/agg-rx.c
index 3d34caf..7dd185f 100644
--- a/agg-rx.c
+++ b/agg-rx.c
@@ -81,6 +81,7 @@ mt76_rx_aggr_check_release(struct mt76_rx_tid *tid, struct sk_buff_head *frames)
 				  mt76_aggr_tid_to_timeo(tid->num)))
 			continue;
 
+		mt76_rx_diag_inc(MT76_RXD_REORDER_TIMEOUT);
 		mt76_rx_aggr_release_frames(tid, frames, status->seqno);
 	}
 
@@ -198,6 +199,7 @@ void mt76_rx_aggr_reorder(struct sk_buff *skb, struct sk_buff_head *frames)
 	}
 
 	if (sn_less) {
+		mt76_rx_diag_inc(MT76_RXD_REORDER_OLD);
 		__skb_unlink(skb, frames);
 		dev_kfree_skb(skb);
 		goto out;
diff --git a/debugfs.c b/debugfs.c
index 41d1d48..e9f48c0 100644
--- a/debugfs.c
+++ b/debugfs.c
@@ -88,6 +88,62 @@ static int mt76_rx_queues_read(struct seq_file *s, void *data)
 	return 0;
 }
 
+static int mt76_rx_drop_diag_read(struct seq_file *s, void *data)
+{
+	static const char * const names[__MT76_RXD_MAX] = {
+		[MT76_RXD_DMA_DROP] = "dma_drop",
+		[MT76_RXD_DMA_LEN] = "dma_len",
+		[MT76_RXD_RX_CHECK] = "rx_check",
+		[MT76_RXD_FILL_FAIL] = "fill_rx_fail",
+		[MT76_RXD_FILL_AMSDU_ERR] = "fill_amsdu_err",
+		[MT76_RXD_FILL_HDR_TRANS_CM] = "fill_hdr_trans_cm",
+		[MT76_RXD_FILL_MAX_LEN] = "fill_max_len",
+		[MT76_RXD_FILL_FRAG_MCAST] = "fill_frag_mcast",
+		[MT76_RXD_FILL_FRAG0] = "fill_frag0",
+		[MT76_RXD_ICV_ERR] = "icv_err",
+		[MT76_RXD_FCS_ERR] = "fcs_err",
+		[MT76_RXD_HDR_TRANS] = "hdr_trans",
+		[MT76_RXD_HDR_TRANS_NO_G4] = "hdr_trans_no_g4",
+		[MT76_RXD_DECRYPTED_NO_G1] = "decrypted_no_g1",
+		[MT76_RXD_NOT_RUNNING] = "not_running",
+		[MT76_RXD_AMSDU_RFC1042] = "amsdu_rfc1042",
+		[MT76_RXD_REORDER_OLD] = "reorder_old",
+		[MT76_RXD_REORDER_TIMEOUT] = "reorder_timeout",
+		[MT76_RXD_PN_CHECKED] = "pn_checked",
+		[MT76_RXD_PN_FAIL] = "pn_fail",
+		[MT76_RXD_PN_FAIL_8023] = "pn_fail_8023",
+		[MT76_RXD_PN_FAIL_EQUAL] = "pn_fail_equal",
+		[MT76_RXD_PN_FAIL_ZERO] = "pn_fail_zero",
+		[MT76_RXD_PN_FAIL_WORK] = "pn_fail_work",
+	};
+	u32 idx = READ_ONCE(mt76_rx_diag_pn_log_idx);
+	int i, n;
+
+	for (i = 0; i < __MT76_RXD_MAX; i++)
+		seq_printf(s, "%s %u\n", names[i], READ_ONCE(mt76_rx_diag[i]));
+
+	for (i = 0; i <= IEEE80211_NUM_TIDS; i++)
+		if (mt76_rx_diag_pn_checked[i] || mt76_rx_diag_pn_fail[i])
+			seq_printf(s, "pn_tid%d checked %u fail %u\n", i,
+				   mt76_rx_diag_pn_checked[i],
+				   mt76_rx_diag_pn_fail[i]);
+
+	seq_printf(s, "pn_log total %u (jiffies now %lu)\n", idx, jiffies);
+	n = min_t(u32, idx, MT76_RX_DIAG_PN_LOG);
+	for (i = n; i > 0; i--) {
+		struct mt76_rx_diag_pn_rec *rec;
+
+		rec = &mt76_rx_diag_pn_log[(idx - i) % MT76_RX_DIAG_PN_LOG];
+		seq_printf(s,
+			   "pnfail j %lu wcid %u tid %u sn %u aggr %u work %u flag 0x%08x pn %6phN last %6phN\n",
+			   rec->jiffies, rec->wcid, rec->tid, rec->seqno,
+			   rec->aggr, rec->from_work, rec->flag, rec->pn,
+			   rec->last);
+	}
+
+	return 0;
+}
+
 void mt76_seq_puts_array(struct seq_file *file, const char *str,
 			 s8 *val, int len)
 {
@@ -120,6 +176,8 @@ mt76_register_debugfs_fops(struct mt76_phy *phy,
 		debugfs_create_blob("otp", 0400, dir, &dev->otp);
 	debugfs_create_devm_seqfile(dev->dev, "rx-queues", dir,
 				    mt76_rx_queues_read);
+	debugfs_create_devm_seqfile(dev->dev, "rx_drop_diag", dir,
+				    mt76_rx_drop_diag_read);
 
 	return dir;
 }
diff --git a/dma.c b/dma.c
index 50b6c3e..f1a4ba9 100644
--- a/dma.c
+++ b/dma.c
@@ -1033,8 +1033,10 @@ mt76_dma_rx_process(struct mt76_dev *dev, struct mt76_queue *q, int budget)
 			continue;
 		}
 
-		if (drop)
+		if (drop) {
+			mt76_rx_diag_inc(MT76_RXD_DMA_DROP);
 			goto free_frag;
+		}
 
 		if (q->rx_head)
 			data_len = q->buf_size;
@@ -1042,6 +1044,7 @@ mt76_dma_rx_process(struct mt76_dev *dev, struct mt76_queue *q, int budget)
 			data_len = SKB_WITH_OVERHEAD(q->buf_size);
 
 		if (data_len < len + q->buf_offset) {
+			mt76_rx_diag_inc(MT76_RXD_DMA_LEN);
 			dev_kfree_skb(q->rx_head);
 			q->rx_head = NULL;
 			goto free_frag;
@@ -1054,8 +1057,10 @@ mt76_dma_rx_process(struct mt76_dev *dev, struct mt76_queue *q, int budget)
 		}
 
 		if (!more && dev->drv->rx_check &&
-		    !(dev->drv->rx_check(dev, data, len)))
+		    !(dev->drv->rx_check(dev, data, len))) {
+			mt76_rx_diag_inc(MT76_RXD_RX_CHECK);
 			goto free_frag;
+		}
 
 		skb = napi_build_skb(data, q->buf_size);
 		if (!skb)
diff --git a/mac80211.c b/mac80211.c
index d852e7b..eaaefb6 100644
--- a/mac80211.c
+++ b/mac80211.c
@@ -910,6 +910,7 @@ static void mt76_rx_release_amsdu(struct mt76_phy *phy, enum mt76_rxq_id q)
 		}
 
 		if (ether_addr_equal(skb->data + offset, rfc1042_header)) {
+			mt76_rx_diag_inc(MT76_RXD_AMSDU_RFC1042);
 			dev_kfree_skb(skb);
 			return;
 		}
@@ -946,6 +947,7 @@ void mt76_rx(struct mt76_dev *dev, enum mt76_rxq_id q, struct sk_buff *skb)
 	struct mt76_phy *phy = mt76_dev_phy(dev, status->phy_idx);
 
 	if (!test_bit(MT76_STATE_RUNNING, &phy->state)) {
+		mt76_rx_diag_inc(MT76_RXD_NOT_RUNNING);
 		dev_kfree_skb(skb);
 		return;
 	}
@@ -1294,8 +1296,36 @@ mt76_rx_convert(struct mt76_dev *dev, struct sk_buff *skb,
 	*hw = mt76_phy_hw(dev, mstat.phy_idx);
 }
 
+u32 mt76_rx_diag[__MT76_RXD_MAX];
+EXPORT_SYMBOL_GPL(mt76_rx_diag);
+
+/* Per-TID PN check counters and the most recent PN check failures */
+u32 mt76_rx_diag_pn_checked[IEEE80211_NUM_TIDS + 1];
+u32 mt76_rx_diag_pn_fail[IEEE80211_NUM_TIDS + 1];
+struct mt76_rx_diag_pn_rec mt76_rx_diag_pn_log[MT76_RX_DIAG_PN_LOG];
+u32 mt76_rx_diag_pn_log_idx;
+
 static void
-mt76_check_ccmp_pn(struct sk_buff *skb)
+mt76_rx_diag_pn_fail_log(struct mt76_rx_status *status, struct mt76_wcid *wcid,
+			 int security_idx, bool from_work)
+{
+	struct mt76_rx_diag_pn_rec *rec;
+
+	rec = &mt76_rx_diag_pn_log[mt76_rx_diag_pn_log_idx++ %
+				   MT76_RX_DIAG_PN_LOG];
+	rec->jiffies = jiffies;
+	rec->wcid = wcid->idx;
+	rec->tid = security_idx;
+	rec->seqno = status->seqno;
+	rec->flag = status->flag;
+	rec->aggr = status->aggr;
+	rec->from_work = from_work;
+	memcpy(rec->pn, status->iv, sizeof(rec->pn));
+	memcpy(rec->last, wcid->rx_key_pn[security_idx], sizeof(rec->last));
+}
+
+static void
+mt76_check_ccmp_pn(struct sk_buff *skb, bool from_work)
 {
 	struct mt76_rx_status *status = (struct mt76_rx_status *)skb->cb;
 	struct mt76_wcid *wcid = status->wcid;
@@ -1341,7 +1371,22 @@ skip_hdr_check:
 	BUILD_BUG_ON(sizeof(status->iv) != sizeof(wcid->rx_key_pn[0]));
 	ret = memcmp(status->iv, wcid->rx_key_pn[security_idx],
 		     sizeof(status->iv));
+	mt76_rx_diag_inc(MT76_RXD_PN_CHECKED);
+	mt76_rx_diag_pn_checked[security_idx]++;
 	if (ret <= 0) {
+		static const u8 zero_pn[6];
+
+		mt76_rx_diag_inc(MT76_RXD_PN_FAIL);
+		mt76_rx_diag_pn_fail[security_idx]++;
+		if (status->flag & RX_FLAG_8023)
+			mt76_rx_diag_inc(MT76_RXD_PN_FAIL_8023);
+		if (!ret)
+			mt76_rx_diag_inc(MT76_RXD_PN_FAIL_EQUAL);
+		if (!memcmp(status->iv, zero_pn, sizeof(zero_pn)))
+			mt76_rx_diag_inc(MT76_RXD_PN_FAIL_ZERO);
+		if (from_work)
+			mt76_rx_diag_inc(MT76_RXD_PN_FAIL_WORK);
+		mt76_rx_diag_pn_fail_log(status, wcid, security_idx, from_work);
 		status->flag |= RX_FLAG_ONLY_MONITOR;
 		return;
 	}
@@ -1523,7 +1568,7 @@ void mt76_rx_complete(struct mt76_dev *dev, struct sk_buff_head *frames,
 	while ((skb = __skb_dequeue(frames)) != NULL) {
 		struct sk_buff *nskb = skb_shinfo(skb)->frag_list;
 
-		mt76_check_ccmp_pn(skb);
+		mt76_check_ccmp_pn(skb, !napi);
 		skb_shinfo(skb)->frag_list = NULL;
 		mt76_rx_convert(dev, skb, &hw, &sta);
 		ieee80211_rx_list(hw, sta, skb, &list);
diff --git a/mt76.h b/mt76.h
index 273f38e..563dfc7 100644
--- a/mt76.h
+++ b/mt76.h
@@ -1531,6 +1531,62 @@ static inline bool mt76_is_testmode_skb(struct mt76_dev *dev,
 #endif
 }
 
+/* Diagnostic counters for frames the RX path drops or hides from mac80211
+ * without any other counter. Read from debugfs mt76/rx_drop_diag.
+ */
+enum mt76_rx_diag_ctr {
+	MT76_RXD_DMA_DROP,
+	MT76_RXD_DMA_LEN,
+	MT76_RXD_RX_CHECK,
+	MT76_RXD_FILL_FAIL,
+	MT76_RXD_FILL_AMSDU_ERR,
+	MT76_RXD_FILL_HDR_TRANS_CM,
+	MT76_RXD_FILL_MAX_LEN,
+	MT76_RXD_FILL_FRAG_MCAST,
+	MT76_RXD_FILL_FRAG0,
+	MT76_RXD_ICV_ERR,
+	MT76_RXD_FCS_ERR,
+	MT76_RXD_HDR_TRANS,
+	MT76_RXD_HDR_TRANS_NO_G4,
+	MT76_RXD_DECRYPTED_NO_G1,
+	MT76_RXD_NOT_RUNNING,
+	MT76_RXD_AMSDU_RFC1042,
+	MT76_RXD_REORDER_OLD,
+	MT76_RXD_REORDER_TIMEOUT,
+	MT76_RXD_PN_CHECKED,
+	MT76_RXD_PN_FAIL,
+	MT76_RXD_PN_FAIL_8023,
+	MT76_RXD_PN_FAIL_EQUAL,
+	MT76_RXD_PN_FAIL_ZERO,
+	MT76_RXD_PN_FAIL_WORK,
+	__MT76_RXD_MAX,
+};
+
+#define MT76_RX_DIAG_PN_LOG	64
+
+struct mt76_rx_diag_pn_rec {
+	unsigned long jiffies;
+	u32 flag;
+	u16 wcid;
+	u16 seqno;
+	u8 tid;
+	u8 aggr;
+	u8 from_work;
+	u8 pn[6];
+	u8 last[6];
+};
+
+extern u32 mt76_rx_diag[__MT76_RXD_MAX];
+extern u32 mt76_rx_diag_pn_checked[IEEE80211_NUM_TIDS + 1];
+extern u32 mt76_rx_diag_pn_fail[IEEE80211_NUM_TIDS + 1];
+extern struct mt76_rx_diag_pn_rec mt76_rx_diag_pn_log[MT76_RX_DIAG_PN_LOG];
+extern u32 mt76_rx_diag_pn_log_idx;
+
+static inline void mt76_rx_diag_inc(enum mt76_rx_diag_ctr ctr)
+{
+	WRITE_ONCE(mt76_rx_diag[ctr], READ_ONCE(mt76_rx_diag[ctr]) + 1);
+}
+
 void mt76_rx(struct mt76_dev *dev, enum mt76_rxq_id q, struct sk_buff *skb);
 void mt76_tx(struct mt76_phy *dev, struct ieee80211_sta *sta,
 	     struct mt76_wcid *wcid, struct sk_buff *skb);
diff --git a/mt7996/mac.c b/mt7996/mac.c
index fb1a4e2..752185a 100644
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -458,16 +458,27 @@ mt7996_mac_fill_rx(struct mt7996_dev *dev, enum mt76_rxq_id q,
 	if (!test_bit(MT76_STATE_RUNNING, &mphy->state))
 		return -EINVAL;
 
-	if (rxd2 & MT_RXD2_NORMAL_AMSDU_ERR)
+	if (rxd2 & MT_RXD2_NORMAL_AMSDU_ERR) {
+		mt76_rx_diag_inc(MT76_RXD_FILL_AMSDU_ERR);
 		return -EINVAL;
+	}
 
 	hdr_trans = rxd2 & MT_RXD2_NORMAL_HDR_TRANS;
-	if (hdr_trans && (rxd1 & MT_RXD1_NORMAL_CM))
+	if (hdr_trans && (rxd1 & MT_RXD1_NORMAL_CM)) {
+		mt76_rx_diag_inc(MT76_RXD_FILL_HDR_TRANS_CM);
 		return -EINVAL;
+	}
+	if (hdr_trans) {
+		mt76_rx_diag_inc(MT76_RXD_HDR_TRANS);
+		if (!(rxd1 & MT_RXD1_NORMAL_GROUP_4))
+			mt76_rx_diag_inc(MT76_RXD_HDR_TRANS_NO_G4);
+	}
 
 	/* ICV error or CCMP/BIP/WPI MIC error */
-	if (rxd1 & MT_RXD1_NORMAL_ICV_ERR)
+	if (rxd1 & MT_RXD1_NORMAL_ICV_ERR) {
+		mt76_rx_diag_inc(MT76_RXD_ICV_ERR);
 		status->flag |= RX_FLAG_ONLY_MONITOR;
+	}
 
 	unicast = FIELD_GET(MT_RXD3_NORMAL_ADDR_TYPE, rxd3) == MT_RXD3_NORMAL_U2M;
 	idx = FIELD_GET(MT_RXD1_NORMAL_WLAN_IDX, rxd1);
@@ -498,8 +509,10 @@ mt7996_mac_fill_rx(struct mt7996_dev *dev, enum mt76_rxq_id q,
 	    !(csum_status & (BIT(0) | BIT(2) | BIT(3))))
 		skb->ip_summed = CHECKSUM_UNNECESSARY;
 
-	if (rxd3 & MT_RXD3_NORMAL_FCS_ERR)
+	if (rxd3 & MT_RXD3_NORMAL_FCS_ERR) {
+		mt76_rx_diag_inc(MT76_RXD_FCS_ERR);
 		status->flag |= RX_FLAG_FAILED_FCS_CRC;
+	}
 
 	if (rxd1 & MT_RXD1_NORMAL_TKIP_MIC_ERR)
 		status->flag |= RX_FLAG_MMIC_ERROR;
@@ -509,12 +522,16 @@ mt7996_mac_fill_rx(struct mt7996_dev *dev, enum mt76_rxq_id q,
 		status->flag |= RX_FLAG_DECRYPTED;
 		status->flag |= RX_FLAG_IV_STRIPPED;
 		status->flag |= RX_FLAG_MMIC_STRIPPED | RX_FLAG_MIC_STRIPPED;
+		if (!(rxd1 & MT_RXD1_NORMAL_GROUP_1))
+			mt76_rx_diag_inc(MT76_RXD_DECRYPTED_NO_G1);
 	}
 
 	remove_pad = FIELD_GET(MT_RXD2_NORMAL_HDR_OFFSET, rxd2);
 
-	if (rxd2 & MT_RXD2_NORMAL_MAX_LEN_ERROR)
+	if (rxd2 & MT_RXD2_NORMAL_MAX_LEN_ERROR) {
+		mt76_rx_diag_inc(MT76_RXD_FILL_MAX_LEN);
 		return -EINVAL;
+	}
 
 	rxd += 8;
 	if (rxd1 & MT_RXD1_NORMAL_GROUP_4) {
@@ -625,13 +642,17 @@ mt7996_mac_fill_rx(struct mt7996_dev *dev, enum mt76_rxq_id q,
 	 * This check fixes vulnerabilities, like CVE-2020-26145.
 	 */
 	if ((ieee80211_has_morefrags(fc) || seq_ctrl & IEEE80211_SCTL_FRAG) &&
-	    FIELD_GET(MT_RXD3_NORMAL_ADDR_TYPE, rxd3) != MT_RXD3_NORMAL_U2M)
+	    FIELD_GET(MT_RXD3_NORMAL_ADDR_TYPE, rxd3) != MT_RXD3_NORMAL_U2M) {
+		mt76_rx_diag_inc(MT76_RXD_FILL_FRAG_MCAST);
 		return -EINVAL;
+	}
 
 	hdr_gap = (u8 *)rxd - skb->data + 2 * remove_pad;
 	if (hdr_trans && ieee80211_has_morefrags(fc)) {
-		if (mt7996_reverse_frag0_hdr_trans(skb, hdr_gap))
+		if (mt7996_reverse_frag0_hdr_trans(skb, hdr_gap)) {
+			mt76_rx_diag_inc(MT76_RXD_FILL_FRAG0);
 			return -EINVAL;
+		}
 		hdr_trans = false;
 	} else {
 		int pad_start = 0;
@@ -1710,6 +1731,7 @@ void mt7996_queue_rx_skb(struct mt76_dev *mdev, enum mt76_rxq_id q,
 			mt76_rx(&dev->mt76, q, skb);
 			return;
 		}
+		mt76_rx_diag_inc(MT76_RXD_FILL_FAIL);
 		fallthrough;
 	default:
 		dev_kfree_skb(skb);
